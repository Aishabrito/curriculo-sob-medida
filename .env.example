# Chave grátis do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-flash-latest, com gemini-2.5-flash e gemini-2.0-flash de reserva)
GEMINI_MODEL=

# Opcional (reserva): chave grátis do Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo do Groq (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=

# Opcional: quantas análises cada pessoa pode fazer por hora (padrão: 8)
RATE_LIMIT_PER_HOUR=
